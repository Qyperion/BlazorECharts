@page "/harness/lifecycle/reliability"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Reflection
@using System.Text
@using System.Text.Json
@using BlazorECharts
@using BlazorECharts.Events
@using BlazorECharts.Options
@using BlazorECharts.Runtime
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Server reliability</PageTitle>
<p data-testid="interactive">@RendererInfo.IsInteractive</p>
<p data-testid="ready-count">@_ready</p>
<p data-testid="error-count">@_errors.Count</p>
<p data-testid="last-error">@(_errors.Count == 0 ? "" : $"{_errors[^1].Code}/{_errors[^1].DetailCode}")</p>
<p data-testid="pings">@_pings</p>
<p data-testid="probe">@_probe</p>
<p data-testid="limited">@_limited</p>
<p data-testid="highlights">@_highlights</p>
<p data-testid="brushes">@_brushes</p>
<button @onclick='() => Title("A")'>Options A</button>
<button @onclick='() => Title("B")'>Options B</button>
<button @onclick="() => _pings++">Ping</button>
<button @onclick="ProbeAsync">Probe</button>
<button @onclick="MountLimitedAsync">Mount limited</button>
<button @onclick="ReadLimitedAsync">Read limited</button>
<div class="chart-container" style="width:600px;height:300px">
    <EChart @ref="_chart" Class="echart" Style="width:100%;height:100%" Options="_options" OnReady="() => _ready++" OnError="Error" />
</div>
<div class="limited-chart" @ref="_limitedElement" style="width:600px;height:300px"></div>

@code {
    // Test-only: shortens this circuit's CircuitOptions.JSInteropDefaultCallTimeout, so a lost reply ends within the test.
    [SupplyParameterFromQuery(Name = "interopTimeout")] public int? InteropTimeout { get; set; }

    // ?limit=none mounts the second facade without a result limit, as a host that does not set MaximumServerResultSize to its hub limit.
    [SupplyParameterFromQuery(Name = "limit")] public string? Limit { get; set; }

    private EChart? _chart;
    private ChartOptions _options = Titled("initial");
    private readonly List<EChartsError> _errors = [];
    private int _ready;
    private int _pings;
    private int _highlights;
    private int _brushes;
    private string _probe = "";
    private string _limited = "";
    private ElementReference _limitedElement;
    private EChartsRuntime? _limitedRuntime;
    private EChartInstance? _limitedChart;

    protected override void OnInitialized()
    {
        if (InteropTimeout is { } milliseconds)
            typeof(JSRuntime).GetProperty("DefaultAsyncTimeout", BindingFlags.Instance | BindingFlags.NonPublic)!
                .SetValue(JS, TimeSpan.FromMilliseconds(milliseconds));
    }

    private static ChartOptions Titled(string text) => new() { Animation = false, Title = new TitleOption { Text = text } };

    private void Title(string text) => _options = Titled(text);

    private void Error(EChartsError error) => _errors.Add(error);

    private async Task ProbeAsync()
    {
        try
        {
            _probe = $"{_chart?.State}:{await _chart!.Instance!.GetWidthAsync()}";
        }
        catch (Exception error)
        {
            _probe = $"{_chart?.State}:{error.GetType().Name}:{EChartsErrorCode(error)}";
        }
    }

    private static string? EChartsErrorCode(Exception error) =>
        error.Message.StartsWith('[') && error.Message.IndexOf(']') is > 1 and var end ? error.Message[1..end] : null;

    // A second facade with the default 32 KiB limit; this host raises its own limit for large exports.
    private async Task MountLimitedAsync()
    {
        _limitedRuntime = new EChartsRuntime(
            JS,
            Navigation,
            Limit == "none" ? new EChartsRuntimeOptions { MaximumServerResultSize = null } : new EChartsRuntimeOptions());
        _limitedChart = await _limitedRuntime.CreateInstanceAsync(_limitedElement, new ChartInitOptions { Renderer = "canvas" });
        var data = new StringBuilder("[");
        for (var i = 0; i < 10_000; i++)
            data.Append(i == 0 ? "" : ",").Append('[').Append(i % 100).Append(',').Append(i / 100).Append(']');

        using var option = JsonDocument.Parse(
            """{"animation":false,"brush":{"xAxisIndex":0,"throttleType":"debounce","throttleDelay":0},"xAxis":{"type":"value"},"yAxis":{"type":"value"},"series":[{"type":"scatter","symbolSize":2,"data":"""
                + data
                + "]}]}");
        await _limitedChart.SetOptionAsync(option.RootElement);

        // ECharts draws the 10 000 points progressively over several frames; a brush before the layout selects nothing.
        await _limitedChart.AwaitStableAsync();
        await _limitedChart.SubscribeAsync(ChartEvents.BrushSelected, _ => InvokeAsync(() =>
        {
            _brushes++;
            StateHasChanged();
        }));
        await _limitedChart.SubscribeAsync(ChartEvents.Highlight, _ => InvokeAsync(() =>
        {
            _highlights++;
            StateHasChanged();
        }));
        _limited = "ready";
    }

    private async Task ReadLimitedAsync()
    {
        try
        {
            await using var snapshot = await _limitedChart!.GetOptionAsync();
            _limited = "read";
        }
        catch (Exception error)
        {
            _limited = $"{error.GetType().Name}:{EChartsErrorCode(error)}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_limitedRuntime is not null)
            await _limitedRuntime.DisposeAsync();
    }
}
