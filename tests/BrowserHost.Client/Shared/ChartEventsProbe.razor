    private void RecordMouse(ClickEvent e)
    {
        switch (e.ComponentType == "series" ? e.SeriesType : e.ComponentType)
        {
            case "pie":
                var color = e.Color is { } value ? ValueJson(EChartsValue.From(value)) : "none";
                _mousePie = FormattableString.Invariant($"{e.Name}/{e.Percent}/{color}");
                break;
            case "sunburst":
                _mouseSunburst = $"{e.Name}/{string.Join(">", e.TreePathInfo?.Select(p => p.Name) ?? [])}/{e.TreePathInfo?[^1].DataIndex}/{e.TreeAncestors is null}";
                break;
            case "tree":
                _mouseTree = $"{e.Name}/{string.Join(">", e.TreeAncestors?.Select(p => p.Name) ?? [])}/{e.TreePathInfo is null}";
                break;
            case "graphic":
                _mouseGraphic = e.Info is { } info ? ValueJson(info) : "missing";
                break;
            case "matrix":
                _mouseMatrix = $"{e.TargetType}/{string.Join(",", e.Coord ?? [])}";
                break;
        }
    }

    private string ValueJson(EChartsValue value)
