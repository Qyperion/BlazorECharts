@code {
    private EChart? _chart;
    private string _payloadDeclaration = "waiting";
    private string _payloadDeclarationJson = "{}";

    private async Task PayloadDeclaration(bool batch)
    {
        var payload = new Payload
        {
            Type = batch ? "downplay" : "highlight",
            EscapeConnect = false,
            Animation = new HighlightPayloadAnimation { Duration = 0, Delay = 0, Easing = "linear" },
        };
        using var extra = JsonDocument.Parse("""{"flag":false,"zero":0,"empty":[]}""");
        payload.AdditionalProperties["future"] = EChartsValue.FromJson(extra.RootElement);
        payload.AdditionalProperties["seriesIndex"] = EChartsValue.From(0);
        payload.AdditionalProperties["notBlur"] = EChartsValue.From(false);
        if (batch)
        {
            payload.Batch = [new HighlightPayloadBatchItem(), new HighlightPayloadBatchItem()];
            for (var i = 0; i < payload.Batch.Length; i++)
            {
                payload.Batch[i]!.AdditionalProperties["dataIndex"] = EChartsValue.From(i);
                payload.Batch[i]!.ExcludeSeriesId = [];
            }
        }
        else
            payload.AdditionalProperties["dataIndex"] = EChartsValue.From(0);

        var json = OptionSerializer.Serialize(payload, Runtime.Serialization).Json;
        if (batch)
            await _chart!.Instance!.DispatchActionAsync(BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadDownplayAction(json));
        else
            await _chart!.Instance!.DispatchActionAsync(BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadHighlightAction(json));

        await _chart.Instance.AwaitStableAsync();
    }

    private void RecordPayload(JsonElement raw)
    {
        var payload = BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadPayload(raw);
        var animation = payload.Animation ?? payload.Batch?[0]?.Animation;
        _payloadDeclarationJson = OptionSerializer.Serialize(payload, Runtime.Serialization).Json.GetRawText();
        _payloadDeclaration = $"{payload.Type}/{payload.EscapeConnect}/{payload.Batch?.Length ?? 0}/{animation?.Duration}/{payload.AdditionalProperties.ContainsKey("future") || payload.Batch?[0]?.AdditionalProperties.ContainsKey("future") == true}";
    }

    private string _downplayDeclaration = "waiting";
    private string _downplayDeclarationJson = "{}";

    private async Task DownplayDeclaration(bool batch)
    {
        var payload = new DownplayPayload
        {
            NotBlur = false,
            EscapeConnect = false,
            Animation = new HighlightPayloadAnimation { Duration = 0, Delay = 0, Easing = "linear" },
        };
        using var extra = JsonDocument.Parse("""{"flag":false,"zero":0,"empty":[]}""");
        payload.AdditionalProperties["future"] = EChartsValue.FromJson(extra.RootElement);
        payload.AdditionalProperties["seriesIndex"] = EChartsValue.From(0);
        if (batch)
        {
            payload.Batch = [new HighlightPayloadBatchItem(), new HighlightPayloadBatchItem()];
            for (var i = 0; i < payload.Batch.Length; i++)
            {
                var item = payload.Batch[i]!;
                item.AdditionalProperties["dataIndex"] = EChartsValue.From(i);
                item.ExcludeSeriesId = [];
            }
        }
        else
            payload.AdditionalProperties["dataIndex"] = EChartsValue.From(0);

        var json = OptionSerializer.Serialize(payload, Runtime.Serialization).Json;
        await _chart!.Instance!.DispatchActionAsync(BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadDownplayAction(json));
        await _chart.Instance.AwaitStableAsync();
    }

    private async Task PrepareDownplay()
    {
        await _chart!.Instance!.DispatchActionAsync(
            new HighlightAction { SeriesIndex = 0, DataIndex = EventActionValue.Array(0d, 1d), NotBlur = true });
        await _chart.Instance.AwaitStableAsync();
    }

    private string _highlightDeclaration = "waiting";
    private string _highlightDeclarationJson = "{}";

    private async Task HighlightDeclaration(bool batch)
    {
        var payload = new HighlightPayload
        {
            NotBlur = false,
            EscapeConnect = false,
            Animation = new HighlightPayloadAnimation { Duration = 0, Delay = 0, Easing = "linear" },
        };
        using var extra = JsonDocument.Parse("""{"flag":false,"zero":0,"empty":[]}""");
        payload.AdditionalProperties["future"] = EChartsValue.FromJson(extra.RootElement);
        payload.AdditionalProperties["seriesIndex"] = EChartsValue.From(0);
        if (batch)
        {
            payload.Batch = [new HighlightPayloadBatchItem(), new HighlightPayloadBatchItem()];
            for (var i = 0; i < payload.Batch.Length; i++)
            {
                var item = payload.Batch[i]!;
                item.AdditionalProperties["dataIndex"] = EChartsValue.From(i);
                item.ExcludeSeriesId = [];
            }
        }
        else
            payload.AdditionalProperties["dataIndex"] = EChartsValue.From(0);

        var json = OptionSerializer.Serialize(payload, Runtime.Serialization).Json;
        await _chart!.Instance!.DispatchActionAsync(BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadHighlightAction(json));
        await _chart.Instance.AwaitStableAsync();
    }

    private string _remainingBrush = "waiting";
    private string _remainingArea = "waiting";
    private string _remainingData = "waiting";
    private string _remainingMagic = "waiting";
    private string _remainingGeo = "waiting";

    private async Task RemainingFixtures()
    {
        await _chart!.Instance!.SetOptionAsync(Create(), new SetOptionOptions { NotMerge = true });
        _status = "remaining ready";
    }

    private async Task SelectBrushResult() => await _chart!.Instance!.DispatchActionAsync(new BrushSelectAction
    {
        EscapeConnect = false,
        Batch = [new ChartBrushSelectBatchItem { BrushId = "brush", BrushIndex = 0, Areas = [],
            Selected = [new ChartBrushSelectedSeries { SeriesId = "s", SeriesName = "A", SeriesIndex = 0, DataIndex = [0, 2] }] }],
    });

    private async Task ApplyDataView()
    {
        var series = new BarSeriesOption { Name = "A", Data = [7d, 3d, 4d] };
        await _chart!.Instance!.DispatchActionAsync(new ChangeDataViewAction
        {
            EscapeConnect = false,
            NewOption = new ChartOptions { Series = OneOrMany<SeriesOption>.Many(series) },
        });
    }

    private async Task ApplyMagicType() => await _chart!.Instance!.DispatchActionAsync(new ChangeMagicTypeAction
    {
        CurrentType = "line",
        NewTitle = new ChartMagicTypeTitle { Line = "Line", Bar = "Bar" },
        FeatureName = "magicType",
        NewOption = new ChartOptions { Series = OneOrMany<SeriesOption>.Many(new LineSeriesOption { Name = "A", Data = [7d, 3d, 4d] }) },
    });

    private async Task GeoFixtures()
    {
        using var map = JsonDocument.Parse("""{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"Square"},"geometry":{"type":"Polygon","coordinates":[[[0,0],[1,0],[1,1],[0,1],[0,0]]]}}]}""");
        await Runtime.RegisterMapAsync("remaining-geo", map.RootElement);
        await _chart!.Instance!.SetOptionAsync(new ChartOptions
        {
            Animation = false,
            Geo = OneOrMany<GeoOption>.One(new GeoOption { Id = "geo", Map = "remaining-geo", Roam = true }),
        }, new SetOptionOptions { NotMerge = true });
        _status = "geo ready";
    }

    private async Task RoamGeo() =>
        await _chart!.Instance!.DispatchActionAsync(new GeoRoamAction { GeoId = "geo", Dx = 10, Dy = 0, EscapeConnect = false });

    private async Task RoamGeoBatch() => await _chart!.Instance!.DispatchActionAsync(new GeoRoamAction
    {
        GeoId = "geo",
        Batch = [new ChartGeoRoamBatchItem { Dx = 0, Dy = 5 }, new ChartGeoRoamBatchItem { Zoom = 2, OriginX = 0, OriginY = 0 }],
    });

    private ChartSubscription<ClickEvent>? _first;
    private ChartSubscription<ClickEvent>? _second;
    private readonly List<ChartSubscription> _subscriptions = [];
    private ChartInitOptions _init = new();
    private readonly ChartOptions _options = Create();
    private string _ready = "waiting";
    private string _status = "initial";
    private string _pointer = "{}";
    private string _references = "[]";
    private string _legend = "{}";
    private string _zoom = "{}";
    private string _brush = "{}";
    private string _parallel = "waiting";
    private int _clicks;
    private int _filtered;
    private int _replaced;
    private int _unmatched;
    private int _rendered;
    private int _finished;
    private bool _svg;
    private string _tooltipShow = "{}";
    private string _tooltipHide = "{}";
    private string _tooltipShowTyped = "waiting";
    private string _tooltipHideTyped = "waiting";
    private string _tooltipItem = "waiting";
    private string _tooltipAxis = "waiting";
    private string _tooltipLeave = "waiting";
    private string _nodeDrag = "{}";
    private string _nodeFocus = "{}";
    private string _nodeUnfocus = "{}";
    private string _nodeDragTyped = "waiting";
    private string _nodeDragBatch = "waiting";
    private string _nodeFocusTyped = "waiting";
    private string _nodeUnfocusTyped = "waiting";
    private string _axisOrder = "{}";
    private string _axisPointer = "{}";
    private string _axisOrderTyped = "waiting";
    private string _axisExpandTyped = "waiting";
    private string _axisPointerTyped = "waiting";
    private string _axisPointerBatch = "waiting";
    private string _sunburstRoot = "{}";
    private string _sunburstHighlight = "{}";
    private string _sunburstNativeRefs = "[]";
    private string _sunburstRootTyped = "waiting";
    private string _sunburstRootBatch = "waiting";
    private string _sunburstHighlightTyped = "waiting";
    private string _sunburstUnhighlightTyped = "waiting";
    private string _sunburstNative = "waiting";
    private EChartsObjectReference? _sunburstNode;
    private string _treeToggle = "{}";
    private string _treeToggleTyped = "waiting";
    private string _treeToggleBatch = "waiting";
    private string _treemapRoot = "{}";
    private string _treemapRootTyped = "waiting";
    private string _treemapRootBatch = "waiting";
    private string _treemapNativeRefs = "[]";
    private string _treemapNative = "waiting";
    private EChartsObjectReference? _treemapNode;

    private static ChartOptions Create()
    {
        using var json = JsonDocument.Parse("""{"animation":false,"tooltip":{"trigger":"item","hideDelay":0},"legend":{},"xAxis":{"type":"category","data":["X","Y","Z"]},"yAxis":{},"dataZoom":[{"type":"inside"}],"brush":{},"series":[{"name":"A","type":"bar","data":[{"value":4,"event":{"category":"sale"}},8,3]},{"name":"B","type":"bar","data":[2,3,1]}]}""");
        return BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadChartOptions(json.RootElement);
    }

    private Task Show(Action update) => InvokeAsync(() =>
    {
        update();
        StateHasChanged();
    });

    private async Task Ready(EChartInstance instance)
    {
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.Highlight, e => Show(() => RecordPayload(e.Raw))));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.Downplay, e => Show(() => RecordPayload(e.Raw))));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.Downplay, e => Show(() =>
        {
            var payload = BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadDownplayPayload(e.Raw);
            var animation = payload.Animation ?? payload.Batch?[0]?.Animation;
            var json = OptionSerializer.Serialize(payload, Runtime.Serialization).Json;
            var easing = animation is null ? "" : OptionSerializer.Serialize(animation, Runtime.Serialization).Json.GetProperty("easing").GetString();
            _downplayDeclarationJson = json.GetRawText();
            _downplayDeclaration = $"{json.GetProperty("type").GetString()}/{payload.NotBlur}/{payload.EscapeConnect}/{payload.Batch?.Length ?? 0}/{easing}/{animation?.Duration}/{payload.AdditionalProperties.ContainsKey("future") || payload.Batch?[0]?.AdditionalProperties.ContainsKey("future") == true}";
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.Highlight, e => Show(() =>
        {
            var payload = BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadHighlightPayload(e.Raw);
            var animation = payload.Animation ?? payload.Batch?[0]?.Animation;
            var json = OptionSerializer.Serialize(payload, Runtime.Serialization).Json;
            var easing = animation is null ? "" : OptionSerializer.Serialize(animation, Runtime.Serialization).Json.GetProperty("easing").GetString();
            _highlightDeclarationJson = json.GetRawText();
            _highlightDeclaration = $"{json.GetProperty("type").GetString()}/{payload.NotBlur}/{payload.EscapeConnect}/{payload.Batch?.Length ?? 0}/{easing}/{animation?.Duration}/{payload.AdditionalProperties.ContainsKey("future") || payload.Batch?[0]?.AdditionalProperties.ContainsKey("future") == true}";
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.BrushSelected, e => Show(() =>
        {
            if (e.Batch is { Length: > 0 } b && b[0].Selected is { Length: > 0 } s)
                _remainingBrush = $"{e.Type}/{s[0].SeriesIndex}/{s[0].DataIndex?.Length}";

            if (e.Raw.TryGetProperty("batch", out var raw) && raw.GetArrayLength() > 0)
            {
                var batch = BlazorECharts.Serialization.Generated.GeneratedOptionMetadata.ReadChartBrushSelectBatchItem(raw[0]);
                if (batch.Areas is { Length: > 0 } areas && batch.Selected is { Length: > 0 } selected)
                {
                    var area = areas[0];
                    _remainingArea = FormattableString.Invariant($"{area.BrushType?.Json.GetString()}/{area.BrushMode?.Json.GetString()}/{area.Transformable}/{area.RemoveOnClick}/{area.Z}/{area.BrushStyle?.Opacity}/{selected[0].SeriesName}/{!string.IsNullOrEmpty(selected[0].SeriesId)}");
                }
            }
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.DataViewChanged, e => Show(() =>
            _remainingData = $"{e.Type}/{e.Raw.GetProperty("escapeConnect").GetBoolean()}")));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.MagicTypeChanged, e => Show(() =>
            _remainingMagic = $"{e.Type}/{e.CurrentType}")));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.GeoRoam, e => Show(() =>
            _remainingGeo = e.Batch is { Length: > 0 } b ? $"{e.Type}/batch/{b.Length}" : $"{e.Type}/{e.Dx}/{e.Dy}")));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.TreeExpandAndCollapse, e => Show(() =>
        {
            _treeToggle = e.Raw.GetRawText();
            _treeToggleTyped = $"{e.Type}/{e.DataIndex}/{e.EscapeConnect}";
            if (e.Batch is { Length: > 0 } b)
                _treeToggleBatch = $"{b.Length}/{b[0].DataIndex}/{b[1].DataIndex}";
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.TreemapRootToNode, async e =>
        {
            foreach (var entry in e.NativeReferences.EnumerateArray())
            {
                var path = entry.GetProperty("path");
                if (path.GetArrayLength() == 1 && path[0].GetString() == "targetNode")
                {
                    if (_treemapNode is not null)
                        await _treemapNode.DisposeAsync();

                    _treemapNode = await Runtime.RetainReferenceAsync(entry.GetProperty("reference"));
                    _treemapNative = "retained";
                }
            }

            await Show(() =>
            {
                _treemapRoot = e.Raw.GetRawText();
                _treemapNativeRefs = e.NativeReferences.GetRawText();
                _treemapRootTyped = $"{e.Type}/{e.Direction?.Json.GetString()}/{e.TargetNodeId}";
                if (e.Batch is { Length: > 0 } b)
                    _treemapRootBatch = $"{b.Length}/{b[0].Direction?.Json.GetString()}/{b[1].Direction?.Json.GetString()}";
            });
        }));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.Click, e => Show(() => RecordMouse(e))));
        _subscriptions.Add(
            await instance.SubscribeAsync(ChartEvents.Click, e => Show(() => _queryMatched++), EventQuery.Select("series", index: 0, dataName: "A")));
        _subscriptions.Add(
            await instance.SubscribeAsync(ChartEvents.Click, e => Show(() => _queryUnmatched++), EventQuery.Select("series", index: 0, dataName: "B")));
        _first = await instance.SubscribeAsync(ChartEvents.Click, e => Show(() =>
        {
            _clicks++;
            _pointer = e.Raw.GetRawText();
            _references = e.NativeReferences.GetRawText();
        }));
        using var query = JsonDocument.Parse("""{"seriesIndex":0}""");
        _second = await instance.SubscribeAsync(ChartEvents.Click, e => Show(() => _filtered++), EventQuery.FromJson(query.RootElement));
        _subscriptions.Add(_first);
        _subscriptions.Add(_second);
        using var unmatchedQuery = JsonDocument.Parse("""{"seriesIndex":1}""");
        _subscriptions.Add(
            await instance.SubscribeAsync(ChartEvents.Click, e => Show(() => _unmatched++), EventQuery.FromJson(unmatchedQuery.RootElement)));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.Rendered, e => Show(() => _rendered++)));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.Finished, e => Show(() => _finished++)));
        _subscriptions.Add(
            await instance.SubscribeAsync(ChartEvents.AxisAreaSelected, e => Show(() => _parallel = e.ParallelAxisId + ":" + e.Intervals![0][0])));
        Runtime.Serialization.Register(new OptionTypeRegistration<AxisAreaSelectProbe>((w, v, c, p) => c.WriteProperty(w, v, "type", v.Type, p)));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.LegendSelectChanged, e => Show(() => _legend = e.Raw.GetRawText())));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.DataZoom, e => Show(() => _zoom = e.Raw.GetRawText())));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.BrushEnd, e => Show(() => _brush = e.Raw.GetRawText())));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.ShowTip, e => Show(() =>
        {
            if (e.Raw.TryGetProperty("unknown", out _))
            {
                _tooltipShow = e.Raw.GetRawText();
                _tooltipShowTyped = $"{e.SeriesIndex}/{e.DataIndex}/{e.X}";
            }

            if (e.From is not null && e.DataIndexInside is not null)
                _tooltipItem = $"{e.SeriesIndex}/{e.DataIndex}/{e.DataIndexInside}";

            if (e.DataByCoordSys is { Length: > 0 } systems && systems[0]?.DataByAxis is { Length: > 0 } axes)
            {
                var axis = axes[0]!;
                var item = axis.SeriesDataIndices![0]!;
                _tooltipAxis = $"{systems[0]!.CoordSysMainType}/{axis.AxisDim}/{item.SeriesIndex}/{item.DataIndex}/{item.DataIndexInside}/{e.EscapeConnect}";
            }
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.HideTip, e => Show(() =>
        {
            if (e.Raw.TryGetProperty("fixture", out _))
            {
                _tooltipHide = e.Raw.GetRawText();
                _tooltipHideTyped = e.From ?? "missing";
            }

            if (e.From is not null)
                _tooltipLeave = "hidden";
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.DragNode, e => Show(() =>
        {
            _nodeDrag = e.Raw.GetRawText();
            _nodeDragTyped = FormattableString.Invariant($"{e.Type}/{e.DataIndex}/{e.LocalX}/{e.LocalY}");
            if (e.Batch is { Length: > 0 } batch)
                _nodeDragBatch = FormattableString.Invariant($"{batch.Length}/{batch[0].DataIndex}/{batch[0].LocalX}/{batch[0].LocalY}");
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.FocusNodeAdjacency, e => Show(() =>
        {
            _nodeFocus = e.Raw.GetRawText();
            _nodeFocusTyped = $"{e.Type}/{e.Batch?.Length ?? 0}";
            _ = e.SeriesId;
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.UnfocusNodeAdjacency, e => Show(() =>
        {
            _nodeUnfocus = e.Raw.GetRawText();
            _nodeUnfocusTyped = $"{e.Type}/{e.Batch?.Length ?? 0}";
        })));
        _ready = "ready";
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.ChangeAxisOrder, e => Show(() =>
        {
            _axisOrder = e.Raw.GetRawText();
            _axisOrderTyped = $"{e.Type}/{e.SortInfo?.OrdinalNumbers?[0]}/{e.IsInitSort}";
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.ParallelAxisExpand, e => Show(() =>
        {
            _axisExpandTyped = $"{e.Type}/{e.AxisExpandWindow?[0]}/{e.AxisExpandWindow?[1]}";
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.UpdateAxisPointer, e => Show(() =>
        {
            _axisPointer = e.Raw.GetRawText();
            if (e.AxesInfo is { Length: > 0 })
                _axisPointerTyped = $"{e.Type}/{e.AxesInfo[0].AxisDim}/{e.AxesInfo[0].AxisIndex}/{e.SeriesIndex}/{e.DataIndex}";

            if (e.Batch is { Length: > 0 })
                _axisPointerBatch = $"{e.Batch.Length}/{e.Batch[0].Type}/{e.Batch[0].AxesInfo?[0].AxisIndex}";
        })));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.SunburstHighlight, e => Show(() =>
        {
            _sunburstHighlight = e.Raw.GetRawText();
            _sunburstHighlightTyped = $"{e.Type}/{e.DataIndex?.Json.GetRawText()}/{e.TargetNodeId}/{e.NotBlur}";
        })));
        _subscriptions.Add(
            await instance.SubscribeAsync(
                ChartEvents.SunburstUnhighlight,
                e => Show(() => _sunburstUnhighlightTyped = $"{e.Type}/{e.DataIndex?.Json.GetRawText()}")));
        _subscriptions.Add(await instance.SubscribeAsync(ChartEvents.SunburstRootToNode, async e =>
        {
            foreach (var entry in e.NativeReferences.EnumerateArray())
            {
                var path = entry.GetProperty("path");
                if (path.GetArrayLength() == 1 && path[0].GetString() == "targetNode")
                {
                    var retained = await Runtime.RetainReferenceAsync(entry.GetProperty("reference"));
                    if (_sunburstNode is not null)
                        await _sunburstNode.DisposeAsync();

                    _sunburstNode = retained;
                    await Show(() =>
                    {
                        _sunburstNative = "retained";
                        _sunburstNativeRefs = e.NativeReferences.GetRawText();
                    });
                }
            }

            await Show(() =>
            {
                _sunburstRoot = e.Raw.GetRawText();
                _sunburstRootTyped = $"{e.Type}/{e.Direction?.Json.GetString()}/{e.TargetNodeId}";
                if (e.Batch is { Length: > 0 })
                    _sunburstRootBatch = $"{e.Batch.Length}/{e.Batch[0].Type}/{e.Batch[0].Direction?.Json.GetString()}/{e.Batch[^1].Direction?.Json.GetString()}";
            });
        }));
    }

