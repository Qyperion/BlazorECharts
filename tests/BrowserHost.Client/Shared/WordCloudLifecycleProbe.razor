@using BlazorECharts.Options
@using BlazorECharts.Runtime
@using BlazorECharts.Values
@using BlazorECharts.WordCloud
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
<h1>WordCloud layout and stable exports</h1>
<p data-testid="status">@_status</p>
<button @onclick="() => Export(false)">Stable WordCloud PNG</button>
<button @onclick="() => Export(true)">Stable WordCloud SVG</button>
<button @onclick="Tooltip">Tooltip WordCloud</button>
<button @onclick="Large">Large WordCloud</button>
<button @onclick="Seeded">Seeded WordCloud</button>
<button @onclick="ResizeSeeded">Resize Seeded WordCloud</button>
<pre data-testid="managed-export" style="max-height:40px;overflow:auto">@_image</pre>
<div class="managed-wordcloud-canvas" style="width:700px;height:400px" @ref="_canvas"></div>
<div class="managed-wordcloud-svg" style="width:700px;height:400px" @ref="_svg"></div>
<div class="tooltip-wordcloud" style="width:500px;height:300px;position:relative" @ref="_tooltip"></div>
<div class="seeded-wordcloud" style="width:600px;height:360px" @ref="_seeded"></div>
@code {
    private ElementReference _canvas;
    private ElementReference _svg;
    private ElementReference _tooltip;
    private ElementReference _seeded;
    private EChartsRuntime? _runtime;
    private EChartInstance? _a;
    private EChartInstance? _b;
    private EChartInstance? _c;
    private EChartInstance? _d;
    private string _status = "waiting";
    private string _image = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _runtime = new(
                JS,
                Navigation,
                new ServiceCollection().AddECharts(o => o.MaximumServerResultSize = 4 * 1024 * 1024).AddWordCloud().Options);
            _a = await _runtime.CreateInstanceAsync(_canvas);
            _b = await _runtime.CreateInstanceAsync(_svg, new() { Renderer = "svg" });
            await _a.SetOptionAsync(Options(1));
            await _b.SetOptionAsync(Options(1));
            await _a.AwaitStableAsync();
            await _b.AwaitStableAsync();
            _status = "ready";
        }
        catch (Exception e)
        {
            _status = e.Message;
        }

        StateHasChanged();
    }

    private static ChartOptions Options(int count) => new()
    {
        Animation = false,
        Series = OneOrMany<SeriesOption>.One(new WordCloudSeriesOption
        {
            Width = "96%",
            Height = "96%",
            SizeRange = [12, 12],
            RotationRange = [0, 0],
            GridSize = 4,
            Shape = "square",
            LayoutAnimation = true,
            TextStyle = new WordCloudTextStyle { FontFamily = "Arial", Color = "#2468ac" },
            Data = Enumerable.Range(0, count).Select(i => new WordCloudDataItem
            {
                Name = $"Україна{i:0000}",
                Value = 1,
                TextStyle = new WordCloudItemTextStyle { Color = i == count - 1 ? "#ff00ff" : "#2468ac" },
            }).ToArray(),
        }),
    };

    private async Task Large()
    {
        _status = "large-pending";
        try
        {
            // LayoutAnimation stays unset: the default non-animated layout places every word in one task.
            await _a!.SetOptionAsync(new ChartOptions
            {
                Animation = false,
                Series = OneOrMany<SeriesOption>.One(new WordCloudSeriesOption
                {
                    Width = "96%",
                    Height = "96%",
                    SizeRange = [12, 12],
                    RotationRange = [0, 0],
                    GridSize = 8,
                    Shape = "square",
                    TextStyle = new WordCloudTextStyle { FontFamily = "Arial", Color = "#2468ac" },
                    Data = Enumerable.Range(0, 10_000).Select(i => new WordCloudDataItem { Name = $"W{i:00000}", Value = 1 }).ToArray(),
                }),
            },
                new() { NotMerge = true });
            await _a.AwaitStableAsync(new() { Timeout = TimeSpan.FromSeconds(60) });
            _status = "large";
        }
        catch (Exception e)
        {
            _status = e.Message;
        }
    }

    private async Task Export(bool svg)
    {
        _status = "exporting";
        try
        {
            var chart = svg ? _b! : _a!;
            await chart.SetOptionAsync(Options(200), new() { NotMerge = true });
            _image = svg
                ? await chart.RenderToSvgStringAsync()
                : await chart.GetDataUrlAsync(new() { Type = ChartImageFormat.Png, BackgroundColor = "white" });
            _status = "exported";
        }
        catch (Exception e)
        {
            _status = e.Message;
        }
    }

    private async Task Tooltip()
    {
        _status = "tooltip-pending";
        try
        {
            _c ??= await _runtime!.CreateInstanceAsync(_tooltip);
            await _c.SetOptionAsync(new ChartOptions
            {
                Animation = false,
                Tooltip = OneOrMany<TooltipOption>.One(new TooltipOption { Show = true, TransitionDuration = 0 }),
                Series = OneOrMany<SeriesOption>.One(new WordCloudSeriesOption
                {
                    Width = "90%",
                    Height = "90%",
                    SizeRange = [14, 14],
                    RotationRange = [0, 0],
                    GridSize = 4,
                    Shape = "square",
                    TextStyle = new WordCloudTextStyle { FontFamily = "Arial" },
                    Tooltip = new SeriesTooltipOption { Formatter = "series {b}" },
                    Data = [new WordCloudDataItem { Name = "Alpha", Value = 3, Tooltip = "item string" },
                        new WordCloudDataItem { Name = "Beta", Value = 2, Tooltip = new SeriesTooltipOption { Formatter = "item object {b}" } },
                        new WordCloudDataItem { Name = "Gamma", Value = 1 }],
                }),
            });
            await _c.AwaitStableAsync();
            _status = "tooltip";
        }
        catch (Exception e)
        {
            _status = e.Message;
        }
    }

    private async Task Seeded()
    {
        _status = "seeded-pending";
        try
        {
            _d ??= await _runtime!.CreateInstanceAsync(_seeded);
            await _d.SetOptionAsync(new ChartOptions
            {
                Animation = false,
                VisualMap = OneOrMany<VisualMapOption?>.One(new ContinuousVisualMapOption
                {
                    Show = false,
                    Min = 1,
                    Max = 30,
                    InRange = new VisualMapChannelsOption { Opacity = new double?[] { 0.2, 1 } },
                }),
                Series = OneOrMany<SeriesOption>.One(new WordCloudSeriesOption
                {
                    Width = "96%",
                    Height = "96%",
                    SizeRange = [12, 28],
                    RotationRange = [-90, 90],
                    RotationStep = 45,
                    GridSize = 4,
                    RandomSeed = "stable",
                    Z = 3,
                    Zlevel = 1,
                    TextStyle = new WordCloudTextStyle { FontFamily = "Arial", Color = "#2468ac" },
                    Data = Enumerable.Range(1, 30).Select(i => new WordCloudDataItem { Name = $"Seed{i:00}", Value = i }).ToArray(),
                }),
            });
            await _d.AwaitStableAsync();
            _status = "seeded";
        }
        catch (Exception e)
        {
            _status = e.Message;
        }
    }

    private async Task ResizeSeeded()
    {
        _status = "resize-pending";
        try
        {
            // A layout at another size comes first; the seed repeats the layout once the size is back.
            await _d!.ResizeAsync(new() { Width = 420, Height = 300 });
            await _d.AwaitStableAsync();
            await _d.ResizeAsync(new() { Width = 600, Height = 360 });
            await _d.AwaitStableAsync();
            _status = "resized";
        }
        catch (Exception e)
        {
            _status = e.Message;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_runtime is not null)
            await _runtime.DisposeAsync();
    }
}
