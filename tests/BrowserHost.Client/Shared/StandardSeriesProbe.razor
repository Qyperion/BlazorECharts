@using BlazorECharts.Events
@using BlazorECharts.Runtime
@using BlazorECharts.Options
@using BlazorECharts.Serialization
@using BlazorECharts.Testing
@using BlazorECharts.Values
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
<h1>Standard series catalog</h1>
<p data-testid="status">@_status</p>
<select aria-label="Series" @onchange="SelectSeries">
    @foreach (var name in StandardSeriesCatalog.Cases.Keys) { <option value="@name">@name</option> }
</select>
<button @onclick="() => Run(Mixed)">Mixed</button>
<button @onclick="() => Run(UpdateMixed)">Update mixed</button>
<button @onclick="() => Run(Snapshot)">Snapshot</button>
<div class="series-chart" style="width:900px;max-width:100%;height:480px" @ref="_element"></div>
<pre data-testid="prepared">@_prepared</pre>
<pre data-testid="snapshot">@_snapshot</pre>
<pre data-testid="typed-event">@_typedEvent</pre>
<pre data-testid="event">@_event</pre>
<pre data-testid="selection">@_selection</pre>
@code {
    private ElementReference _element;
    private EChartsRuntime? _runtime;
    private EChartInstance? _chart;
    private ChartSubscription? _click;
    private ChartSubscription? _select;
    private string _status = "waiting";
    private string _prepared = "";
    private string _snapshot = "";
    private string _typedEvent = "";
    private string _event = "";
    private string _selection = "";

    private string Module => new Uri(new Uri(Navigation.BaseUri), "modules/series-functions.js").AbsoluteUri;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Run(async () =>
        {
            _runtime = new(JS, Navigation, new() { MaximumServerResultSize = 4 * 1024 * 1024 });
            await _runtime.RegisterMapAsync("series-map", StandardSeriesCatalog.Parse(StandardSeriesCatalog.Map));
            _chart = await _runtime.CreateInstanceAsync(_element);
            _click = await _chart.SubscribeAsync(ChartEvents.Click, e => InvokeAsync(() =>
            {
                _typedEvent = $"{e.SeriesType}|{e.SeriesId}|{e.DataIndex}|{e.Name}";
                _event = e.Raw.GetRawText();
                StateHasChanged();
            }));
            _select = await _chart.SubscribeAsync(ChartEvents.SelectChanged, e => InvokeAsync(() =>
            {
                _selection = $"{e.IsFromClick}|{e.Selected?.FirstOrDefault()?.SeriesIndex}";
                StateHasChanged();
            }));
            await Apply("bar");
        });
        StateHasChanged();
    }

    private async Task Run(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception e)
        {
            _status = "error:" + e;
        }
    }

    private async Task Apply(string name)
    {
        var options = StandardSeriesCatalog.Create(name, Module);
        _prepared = OptionSerializer.Serialize(options, _runtime!.Serialization).Json.GetRawText();
        await _chart!.SetOptionAsync(options, new SetOptionOptions { NotMerge = true });
        await _chart.AwaitStableAsync();
        _status = "ready:" + name;
    }

    private async Task SelectSeries(ChangeEventArgs e)
    {
        if (e.Value is string name)
            await Run(() => Apply(name));
    }

    private async Task Mixed()
    {
        await _chart!.SetOptionAsync(StandardSeriesCatalog.Mixed(), new SetOptionOptions { NotMerge = true });
        await _chart.AwaitStableAsync();
        _status = "mixed";
    }

    private async Task UpdateMixed()
    {
        await _chart!.SetOptionAsync(StandardSeriesCatalog.Mixed(true), new SetOptionOptions { ReplaceMerge = OneOrMany<string>.One("series") });
        await _chart.AwaitStableAsync();
        _status = "mixed-updated";
    }

    private async Task Snapshot()
    {
        await using var snapshot = await _chart!.GetOptionAsync();
        _snapshot = OptionSerializer.Serialize(snapshot.Options, _runtime!.Serialization).Json.GetRawText();
        _status = "snapshot";
    }

    public async ValueTask DisposeAsync()
    {
        if (_click is not null)
            await _click.DisposeAsync();

        if (_select is not null)
            await _select.DisposeAsync();

        if (_chart is not null)
            await _chart.DisposeAsync();

        if (_runtime is not null)
            await _runtime.DisposeAsync();
    }
}
