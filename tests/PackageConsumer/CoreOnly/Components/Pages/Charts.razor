@page "/charts"
@rendermode InteractiveServer
<PageTitle>Core-only charts</PageTitle>
<p data-testid="status">@_status</p>
<p data-testid="png-length">@_pngLength</p>
<pre data-testid="png-export" hidden>@_png</pre>
<pre data-testid="svg-export" hidden>@_svg</pre>
<EChart Class="bar-chart" Style="width:640px;height:320px" Options="_svgBar" InitOptions="_svgRenderer" OnReady="SvgReadyAsync" OnError="Failed" />
<EChart Class="canvas-chart" Style="width:640px;height:320px" Options="_canvasBar" OnReady="CanvasReadyAsync" OnError="Failed" />

@code {
    private readonly ChartOptions _svgBar = ConsumerCharts.Bar("core only");
    private readonly ChartOptions _canvasBar = ConsumerCharts.Bar("core only canvas");
    private readonly ChartInitOptions _svgRenderer = new() { Renderer = "svg" };
    private EChartInstance? _svgInstance;
    private EChartInstance? _canvasInstance;
    private string _status = "loading";
    private string _svg = "";
    private string _png = "";
    private int _pngLength;
    private bool _completing;

    private Task SvgReadyAsync(EChartInstance instance)
    {
        _svgInstance = instance;
        return CompleteAsync();
    }

    private Task CanvasReadyAsync(EChartInstance instance)
    {
        _canvasInstance = instance;
        return CompleteAsync();
    }

    private void Failed(EChartsError error) => _status = $"failed: {error.Code}: {error.Message}";

    private async Task CompleteAsync()
    {
        if (_svgInstance is null || _canvasInstance is null || _completing)
            return;

        _completing = true;
        try
        {
            await _svgInstance.AwaitStableAsync();
            _svg = await _svgInstance.RenderToSvgStringAsync();
            _png = await _canvasInstance.GetDataUrlAsync();
            _pngLength = _png.Length;
            _status = "ready";
        }
        catch (Exception error)
        {
            _status = $"failed: {error.GetType().Name}: {error.Message}";
        }
    }
}
