<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AssemblyName>PackageConsumer.Standalone</AssemblyName>
    <RootNamespace>PackageConsumer.Standalone</RootNamespace>

    <!-- tools/Release/test-aot.ps1 publishes this app twice: trimmed (the default for WebAssembly) and with RunAOTCompilation=true. -->
    <PublishTrimmed>true</PublishTrimmed>

    <!-- The Blazor SDK hides trim analysis by default; every warning is reported per member so test-aot.ps1 can attribute it. -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- Trim warnings stay warnings here: test-aot.ps1 fails on any warning from the packages or this app and lists the others. -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>

    <!-- The compiler's trim analyzer reports IL2111 for Router.NotFoundPage in the generated App; it stays visible for the same gate. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2111</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />

    <PackageReference Include="Qyperion.BlazorECharts" Version="$(BlazorEChartsVersion)" />
    <PackageReference Include="Qyperion.BlazorECharts.WordCloud" Version="$(BlazorEChartsVersion)" />
  </ItemGroup>

</Project>
