<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AssemblyName>PackageConsumer.Wasm.Client</AssemblyName>
    <RootNamespace>PackageConsumer.Wasm.Client</RootNamespace>

    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>

    <!-- Trimmed and AOT outputs are verified with the Standalone consumer (tools/Release/test-aot.ps1). -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />

    <PackageReference Include="Qyperion.BlazorECharts" Version="$(BlazorEChartsVersion)" />
    <PackageReference Include="Qyperion.BlazorECharts.WordCloud" Version="$(BlazorEChartsVersion)" />
  </ItemGroup>

</Project>
