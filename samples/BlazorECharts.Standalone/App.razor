<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="[typeof(ExampleRegistry).Assembly]">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(DemoLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(DemoLayout)">
            <h1>Page not found</h1>
            <p><a href="examples">Browse the examples</a></p>
        </LayoutView>
    </NotFound>
</Router>
