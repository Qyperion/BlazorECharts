<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <StaticWebAssetBasePath>_content/BlazorECharts.Examples</StaticWebAssetBasePath>

    <!-- BL0016 asks for a try/catch around every JS interop call. An example reports a failure where its operation starts
         (ExampleBase), and a failed page script of the demo reaches the Blazor error UI. -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Examples/**/*.cs;Examples/**/*.razor" LogicalName="Source/Examples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BlazorECharts/BlazorECharts.csproj" />
    <ProjectReference Include="../../src/BlazorECharts.WordCloud/BlazorECharts.WordCloud.csproj" />
  </ItemGroup>

</Project>
