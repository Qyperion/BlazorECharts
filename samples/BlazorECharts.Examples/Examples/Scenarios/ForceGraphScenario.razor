@namespace BlazorECharts.Examples.Scenarios
@using System.Globalization
@using BlazorECharts.Events
@using BlazorECharts.Values
@inherits ExampleBase
@implements IAsyncDisposable

<p class="example-controls" data-testid="roam-state" data-roam-events="@_roamEvents" data-zoom="@_zoom.ToString(CultureInfo.InvariantCulture)" aria-live="polite">
    @(_roamEvents == 0 ? "Scroll to zoom, drag the background to pan, drag a node to move it." : $"Roam events: {_roamEvents}, zoom {_zoom:0.00}×")
</p>
<EChart Class="example-chart" Style="height:460px" Options="_options" InitOptions="InitOptions" OnReady="OnReadyAsync" OnError="FailAsync" />

@code {
    private static readonly (string Name, int Team, double Messages)[] People =
    [
        ("Avery", 0, 820), ("Blake", 0, 610), ("Casey", 1, 540), ("Devon", 1, 480), ("Emery", 2, 450), ("Finley", 2, 390),
        ("Harper", 0, 300), ("Jordan", 1, 260), ("Kendall", 2, 210), ("Logan", 0, 160), ("Morgan", 1, 120), ("Parker", 2, 80),
    ];

    // From, to and the number of replies.
    private static readonly (int From, int To, double Replies)[] Replies =
    [
        (0, 1, 120), (1, 0, 96), (0, 2, 64), (2, 3, 80), (3, 2, 70), (4, 5, 66), (5, 4, 58), (0, 4, 40), (1, 6, 38),
        (2, 7, 30), (4, 8, 28), (6, 9, 22), (7, 10, 18), (8, 11, 14), (3, 7, 26), (5, 8, 24), (9, 0, 12), (11, 4, 10),
    ];

    private readonly List<ChartSubscription> _subscriptions = [];
    private ChartOptions? _options;
    private int _roamEvents;
    private double _zoom = 1;

    public static ChartOptions CreateOptions()
    {
        var maxMessages = People.Max(person => person.Messages);
        return new()
        {
            Title = new TitleOption { Text = "Who replies to whom", Left = "center" },
            Tooltip = new TooltipOption { Trigger = "item" },
            Legend = new LegendOption { Bottom = 0 },
            Series = new GraphSeriesOption
            {
                Name = "Replies",
                Top = 50,
                Bottom = 40,
                Layout = "force",
                // The layout is computed before the first frame, so the picture is stable when the chart is ready.
                Force = new() { Repulsion = 220, EdgeLength = [60, 150], Gravity = 0.08, LayoutAnimation = false },
                Roam = true,
                Draggable = true,
                EdgeSymbol = ["none", "arrow"],
                EdgeSymbolSize = 7,
                Label = new() { Show = true, Position = "right" },
                LineStyle = new() { Color = "source", Opacity = 0.6, Curveness = 0.15 },
                Emphasis = new() { Focus = "adjacency", LineStyle = new() { Width = 4 } },
                Categories =
                [
                    new GraphCategoryItemOption { Name = "Design" },
                    new GraphCategoryItemOption { Name = "Support" },
                    new GraphCategoryItemOption { Name = "Sales" },
                ],
                Data = [.. People.Select(person => (GraphSeriesOptionDataItem?)new GraphNodeItemOption
                {
                    Name = person.Name,
                    Value = person.Messages,
                    Category = person.Team,
                    SymbolSize = Math.Round(14 + Math.Sqrt(person.Messages / maxMessages) * 40),
                })],
                Links = [.. Replies.Select(reply => (GraphEdgeItemOption?)new GraphEdgeItemOption
                {
                    Source = People[reply.From].Name,
                    Target = People[reply.To].Name,
                    Value = reply.Replies,
                    LineStyle = new() { Width = Math.Round(1 + reply.Replies / 30, 1) },
                })],
            },
        };
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _options = Accessible(CreateOptions());
    }

    private async Task OnReadyAsync(EChartInstance chart)
    {
        _subscriptions.Add(await chart.SubscribeAsync(ChartEvents.GraphRoam, e => InvokeAsync(() =>
        {
            _roamEvents++;

            // Each graphRoam event carries the zoom step of one wheel or pinch; pans carry dx/dy only.
            if (e.Zoom is { } step)
                _zoom *= step;

            StateHasChanged();
        })));
        await ReadyAsync(chart);
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var subscription in _subscriptions)
            await subscription.DisposeAsync();
    }
}
