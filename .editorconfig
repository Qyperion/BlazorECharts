root = true

# Text files are stored with LF and without a BOM (.gitattributes)
[*]
charset = utf-8
end_of_line = lf
indent_style = space

# Project and solution files
[*.{csproj,props,targets,slnx}]
indent_size = 2

# Web, script and data files
[*.{ts,js,mjs,json,yml,yaml}]
indent_size = 2

[*.{razor,css,ps1}]
indent_size = 4

# C# files
[*.cs]

#### Core EditorConfig Options ####

# Indentation and spacing
indent_size = 4
tab_width = 4

# New line preferences
insert_final_newline = true

#### .NET Coding Conventions ####

# Organize usings: the defaults (System first, no blank lines between groups) match the code.
# Setting either option makes dotnet format reorder usings across the // snippet markers in tests/Documentation.

# Namespace match folder
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = error

# Namespace declarations
csharp_style_namespace_declarations = file_scoped:error


#### C# Style Preferences ####

# Collection expressions — IDE0028, IDE0300, IDE0301, IDE0302, IDE0303, IDE0304, IDE0305
dotnet_style_prefer_collection_expression = when_types_exactly_match:warning
dotnet_diagnostic.IDE0305.severity = none

# Pattern matching — IDE0019, IDE0020, IDE0038, IDE0066, IDE0083, IDE0170
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:suggestion

# Switch expression — IDE0066
csharp_style_prefer_switch_expression = true:suggestion

#### Expression-Level Preferences ####

# Use object/collection initializers
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning

# Use conditional expression
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion

# Use compound assignment
dotnet_style_prefer_compound_assignment = true:warning

# Use simplified interpolation
dotnet_style_prefer_simplified_interpolation = true:warning

# Use tuple names
dotnet_style_explicit_tuple_names = true:warning


#### Null-Checking Preferences ####

# Use throw expression
csharp_style_throw_expression = true:warning

# Use null propagation
dotnet_style_null_propagation = true:warning

# Use argument exception throw helpers (CA1510-CA1512)
dotnet_diagnostic.CA1510.severity = warning
dotnet_diagnostic.CA1511.severity = warning
dotnet_diagnostic.CA1512.severity = warning
# CA1513 keeps its default: ObjectDisposedException names the public type (nameof), which ThrowIf cannot

# Disable not important and sometimes wrong suggestions
dotnet_diagnostic.CA1806.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1860.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1862.severity = none
dotnet_diagnostic.CA1869.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA2208.severity = none
dotnet_diagnostic.CA2211.severity = none
dotnet_diagnostic.IDE0062.severity = none
dotnet_diagnostic.IDE0270.severity = none
dotnet_diagnostic.SYSLIB1045.severity = none

#### Modifier Preferences ####

# Accessibility modifiers
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

#### Unnecessary Code ####

# Remove unnecessary cast — IDE0004
dotnet_diagnostic.IDE0004.severity = warning

# Remove unnecessary import — IDE0005
dotnet_diagnostic.IDE0005.severity = warning

# Remove unreachable code — IDE0035
dotnet_diagnostic.IDE0035.severity = warning

# Use expression body for methods
dotnet_diagnostic.IDE0022.severity = none

# Use index/range operators — IDE0056, IDE0057
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion

# Use simple 'using' statement — IDE0063
csharp_prefer_simple_using_statement = true:suggestion

#### Formatting ####

csharp_prefer_braces = false

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Spacing
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false


#### xUnit v3 Analyzer Rules ####
dotnet_diagnostic.xUnit1012.severity = none
dotnet_diagnostic.xUnit1045.severity = none
dotnet_diagnostic.xUnit1004.severity = none

#### Path exceptions ####

# The example sources keep the BlazorECharts.Examples.* namespaces without the Examples folder
[samples/BlazorECharts.Examples/Examples/**.cs]
dotnet_diagnostic.IDE0130.severity = none

# Documentation snippets list the usings a reader needs for the whole page
[tests/Documentation/**.cs]
dotnet_diagnostic.IDE0005.severity = none
